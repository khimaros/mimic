#!/usr/bin/env sh
# mimic -- drive the mimic service from a shell (termux/adb).
#
# it speaks to whichever surface is reachable:
#   http     -- POST to the localhost rest api (works from proot, native termux,
#               or the host via `adb forward`). preferred when reachable.
#   intents  -- `am`/`termux-am broadcast` to the receiver, base64 result decode.
#
# to get a token: open the app, tap "start pairing", then `mimic pair CODE`. the
# code is exchanged (over the active surface) for a per-client token saved here.
#
# config (env):
#   MIMIC_TRANSPORT  force "http" or "intents" (default: auto-detect).
#   MIMIC_HOST       host:port of the rest/mcp server (default 127.0.0.1:8473).
#   MIMIC_AM         the am command for the intents surface (default: termux-am if
#                   present, else am). set "adb shell am" to drive over usb.
#   MIMIC_HOME       token directory (default $XDG_CONFIG_HOME/mimic).

set -u

PKG="com.khimaros.mimic"
COMPONENT="$PKG/.CommandReceiver"
ACT_PREFIX="$PKG.action."

HOST="${MIMIC_HOST:-127.0.0.1:8473}"
ADB="${MIMIC_ADB:-adb}"
MIMIC_HOME="${MIMIC_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/mimic}"
TOKEN_FILE="$MIMIC_HOME/token"
ID_FILE="$MIMIC_HOME/id"

have() { command -v "$1" >/dev/null 2>&1; }

# how to run `am` for the intents surface, best first:
#   MIMIC_AM override > adb (shell uid, can return results, even over wireless)
#   > termux-am (native termux shell) > bare am.
if [ -n "${MIMIC_AM:-}" ]; then
    AM_KIND=direct; AM="$MIMIC_AM"
elif have "${ADB%% *}" && [ "$($ADB get-state 2>/dev/null)" = device ]; then
    AM_KIND=adb; AM="$ADB shell am"
elif have termux-am; then
    AM_KIND=direct; AM="termux-am"
else
    AM_KIND=direct; AM="am"
fi

TOKEN=""
[ -f "$TOKEN_FILE" ] && TOKEN=$(cat "$TOKEN_FILE")

die() { echo "mimic: $*" >&2; exit 1; }
need_token() { [ -n "$TOKEN" ] || die "no token; start pairing in the app, then 'mimic pair CODE' (or 'mimic set-token TOKEN')"; }

# single-quote an argument for a remote shell (adb shell re-parses its command).
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# run `am <args...>` either directly or, for adb, as one shell-quoted remote
# command so values containing spaces survive the extra shell hop.
run_am_argv() {
    if [ "$AM_KIND" = adb ]; then
        _rc="am"
        for _a in "$@"; do _rc="$_rc $(shq "$_a")"; done
        $ADB shell "$_rc"
    else
        $AM "$@"
    fi
}

detect_transport() {
    [ -n "${MIMIC_TRANSPORT:-}" ] && { printf '%s' "$MIMIC_TRANSPORT"; return; }
    if have curl && curl -sS -m 1 "http://$HOST/healthz" >/dev/null 2>&1; then
        printf 'http'
    else
        printf 'intents'
    fi
}
TRANSPORT=$(detect_transport)

# minimal json string escape (backslash and double-quote); ascii values only.
json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# extract + decode the base64 result data from an `am broadcast` reply.
decode_output() {
    _b64=$(printf '%s\n' "$1" | sed -n 's/.*data="\([^"]*\)".*/\1/p' | tail -n1)
    if [ -z "$_b64" ]; then
        echo "mimic: no response (intents surface off, or am cannot return a result here -- try the http surface)" >&2
        return 1
    fi
    printf '%s' "$_b64" | base64 -d 2>/dev/null
}

# print the response. default: the raw json envelope (no dependencies). with
# --pretty: use jq to unwrap .data (raw text for strings, pretty json otherwise),
# erroring clearly if jq is absent. exit status reflects the ok flag.
emit() {
    _d="$1"
    if [ "${PRETTY:-0}" = 1 ]; then
        have jq || die "--pretty requires jq, which is not installed (omit --pretty for raw json)"
        if [ "$(printf '%s' "$_d" | jq -r '.ok' 2>/dev/null)" = "true" ]; then
            printf '%s' "$_d" | jq -r '.data'
            return 0
        fi
        echo "mimic: $(printf '%s' "$_d" | jq -r '.error // "error"')" >&2
        return 1
    fi
    printf '%s\n' "$_d"
    case "$_d" in *'"ok":true'*) return 0 ;; *) return 1 ;; esac
}

# send a short-named command with key/value argument pairs, over the active
# transport. usage: send ACTION [key value]...
send() {
    if [ "$TRANSPORT" = http ]; then send_http "$@"; else send_intents "$@"; fi
}

send_http() {
    _action="$1"; shift
    _path=$(printf '%s' "$_action" | tr 'A-Z' 'a-z')
    _body="{"
    _first=1
    while [ $# -gt 0 ]; do
        [ $_first -eq 1 ] || _body="$_body,"
        _body="$_body\"$1\":\"$(json_escape "$2")\""
        _first=0
        shift 2
    done
    _body="$_body}"
    _resp=$(curl -sS -H "x-mimic-token: $TOKEN" -H "content-type: application/json" \
        -X POST "http://$HOST/v1/$_path" -d "$_body" 2>/dev/null || true)
    [ -n "$_resp" ] || { echo "mimic: no response from http://$HOST" >&2; return 1; }
    emit "$_resp"
}

send_intents() {
    _action="$1"; shift
    # convert key/value pairs into "--es key value" while preserving order/spaces.
    _count=$#
    _i=0
    while [ $_i -lt $_count ]; do
        _k="$1"; _v="$2"; shift 2
        set -- "$@" --es "$_k" "$_v"
        _i=$(( _i + 2 ))
    done
    set -- broadcast -n "$COMPONENT" -a "$ACT_PREFIX$_action" --es token "$TOKEN" "$@"
    _out=$(run_am_argv "$@" 2>/dev/null || true)
    _dec=$(decode_output "$_out") || return 1
    emit "$_dec"
}

cmd_status() {
    [ "$TRANSPORT" = http ] && need_token
    [ -f "$ID_FILE" ] && echo "mimic: this client id: $(cat "$ID_FILE") (revoke in the app)" >&2
    send STATUS
}

# persist the token mode 600, plus the client id when known (pairing) or clear a
# stale id when saving a hand-copied token.
save_token() {
    mkdir -p "$MIMIC_HOME"
    ( umask 077; printf '%s' "$1" > "$TOKEN_FILE" )
    chmod 600 "$TOKEN_FILE" 2>/dev/null || true
    if [ -n "${2:-}" ]; then ( umask 077; printf '%s' "$2" > "$ID_FILE" ); else rm -f "$ID_FILE"; fi
}

cmd_set_token() {
    _t="${1:-}"
    [ -n "$_t" ] || { printf 'paste token: ' >&2; read -r _t; }
    save_token "$_t" ""
    echo "mimic: token saved to $TOKEN_FILE"
}

# re-download this script from the host server (served unauthenticated). default
# destination is this script's own path. needs curl and the http surface on.
cmd_update() {
    have curl || die "update needs curl"
    _dest="${1:-$0}"
    _url="http://$HOST/cli/mimic"
    _tmp="$_dest.new.$$"
    if curl -sS -f "$_url" -o "$_tmp" 2>/dev/null; then
        chmod +x "$_tmp" 2>/dev/null || true
        mv "$_tmp" "$_dest" && echo "mimic: updated $_dest from $_url"
    else
        rm -f "$_tmp"
        die "could not fetch $_url (is the http surface on?)"
    fi
}

# pair: exchange a one-time code (shown in the app after "start pairing") for a
# fresh per-client token, over whichever surface is active -- http via the
# unauthenticated POST /pair, else the PAIR broadcast. saves the token and the
# client id; the app lists this client by that id and can revoke it.
cmd_pair() {
    _code="${1:-}"
    _label="${2:-$(hostname 2>/dev/null || echo cli)}"
    if [ -z "$_code" ]; then printf 'enter pairing code: ' >&2; read -r _code; fi
    if [ "$TRANSPORT" = http ]; then
        _resp=$(pair_http "$_code" "$_label")
    else
        _resp=$(pair_intents "$_code" "$_label") || return 1
    fi
    case "$_resp" in
        *'"ok":true'*)
            _token=$(printf '%s' "$_resp" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
            _id=$(printf '%s' "$_resp" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')
            save_token "$_token" "$_id"
            echo "mimic: paired as client ${_id:-?}; token saved to $TOKEN_FILE" >&2 ;;
        *)
            _err=$(printf '%s' "$_resp" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')
            die "pairing failed: ${_err:-no response (open a pairing window in the app first)}" ;;
    esac
}

pair_http() {
    have curl || die "http pairing needs curl"
    _b="{\"code\":\"$(json_escape "$1")\",\"label\":\"$(json_escape "$2")\"}"
    curl -sS -H "content-type: application/json" -X POST "http://$HOST/pair" -d "$_b" 2>/dev/null || true
}

pair_intents() {
    decode_output "$(run_am_argv broadcast -n "$COMPONENT" -a "${ACT_PREFIX}PAIR" \
        --es code "$1" --es label "$2" 2>/dev/null || true)"
}

# view: dump the (filtered) tree.
cmd_view() {
    need_token
    _filter=; _format=; _depth=; _pkg=; _fields=
    while [ $# -gt 0 ]; do
        case "$1" in
            --filter) _filter="$2"; shift 2 ;;
            --format) _format="$2"; shift 2 ;;
            --max-depth) _depth="$2"; shift 2 ;;
            --package) _pkg="$2"; shift 2 ;;
            --fields) _fields="$2"; shift 2 ;;
            *) die "dump: unknown option $1" ;;
        esac
    done
    set -- DUMP
    [ -n "$_filter" ] && set -- "$@" filter "$_filter"
    [ -n "$_format" ] && set -- "$@" format "$_format"
    [ -n "$_depth" ]  && set -- "$@" max_depth "$_depth"
    [ -n "$_pkg" ]    && set -- "$@" package "$_pkg"
    [ -n "$_fields" ] && set -- "$@" fields "$_fields"
    send "$@"
}

cmd_find() {
    need_token
    _query="${1:-}"; [ -n "$_query" ] || die "usage: mimic find QUERY [--by text|id|class|desc] [--match exact|contains|regex] [--format ...] [--fields ...] [--filter ...] [--max-depth N] [--package P]"
    shift
    _by=; _match=; _format=; _fields=; _depth=; _pkg=; _filter=
    while [ $# -gt 0 ]; do
        case "$1" in
            --by) _by="$2"; shift 2 ;;
            --match) _match="$2"; shift 2 ;;
            --format) _format="$2"; shift 2 ;;
            --fields) _fields="$2"; shift 2 ;;
            --max-depth) _depth="$2"; shift 2 ;;
            --package) _pkg="$2"; shift 2 ;;
            --filter) _filter="$2"; shift 2 ;;
            *) die "find: unknown option $1" ;;
        esac
    done
    set -- FIND query "$_query"
    [ -n "$_by" ]     && set -- "$@" by "$_by"
    [ -n "$_match" ]  && set -- "$@" match "$_match"
    [ -n "$_format" ] && set -- "$@" format "$_format"
    [ -n "$_fields" ] && set -- "$@" fields "$_fields"
    [ -n "$_depth" ]  && set -- "$@" max_depth "$_depth"
    [ -n "$_pkg" ]    && set -- "$@" package "$_pkg"
    [ -n "$_filter" ] && set -- "$@" filter "$_filter"
    send "$@"
}

point_gesture() {
    _action="$1"; shift
    [ $# -ge 2 ] || die "usage: mimic <gesture> X Y [--duration MS]"
    _x="$1"; _y="$2"; shift 2
    _dur=
    while [ $# -gt 0 ]; do case "$1" in --duration) _dur="$2"; shift 2 ;; *) die "unknown option $1" ;; esac; done
    set -- "$_action" x "$_x" y "$_y"
    [ -n "$_dur" ] && set -- "$@" duration "$_dur"
    send "$@"
}

cmd_tap() { need_token; point_gesture TAP "$@"; }
cmd_long() { need_token; point_gesture LONG_PRESS "$@"; }

cmd_swipe() {
    need_token
    [ $# -ge 4 ] || die "usage: mimic swipe X1 Y1 X2 Y2 [--duration MS]"
    _x1="$1"; _y1="$2"; _x2="$3"; _y2="$4"; shift 4
    _dur=
    while [ $# -gt 0 ]; do case "$1" in --duration) _dur="$2"; shift 2 ;; *) die "swipe: unknown option $1" ;; esac; done
    set -- SWIPE x "$_x1" y "$_y1" x2 "$_x2" y2 "$_y2"
    [ -n "$_dur" ] && set -- "$@" duration "$_dur"
    send "$@"
}

cmd_click() {
    need_token
    _by=; _query=; _match=; _x=; _y=
    case "${1:-}" in
        --id) _by=id; _query="$2"; shift 2 ;;
        --text) _by=text; _query="$2"; shift 2 ;;
        --class) _by=class; _query="$2"; shift 2 ;;
        --desc) _by=desc; _query="$2"; shift 2 ;;
        *) [ $# -ge 2 ] || die "usage: mimic click X Y | --id ID | --text T [--match M]"
           _x="$1"; _y="$2"; shift 2 ;;
    esac
    while [ $# -gt 0 ]; do case "$1" in --match) _match="$2"; shift 2 ;; *) die "click: unknown option $1" ;; esac; done
    if [ -n "$_by" ]; then
        set -- CLICK by "$_by" query "$_query"
        [ -n "$_match" ] && set -- "$@" match "$_match"
    else
        set -- CLICK by coords x "$_x" y "$_y"
    fi
    send "$@"
}

cmd_text() {
    need_token
    _value="${1:-}"; [ -n "$_value" ] || die "usage: mimic text VALUE [--id ID | --text T | --class C | --desc D] [--match M]"
    shift
    _by=; _query=; _match=
    while [ $# -gt 0 ]; do
        case "$1" in
            --id) _by=id; _query="$2"; shift 2 ;;
            --text) _by=text; _query="$2"; shift 2 ;;
            --class) _by=class; _query="$2"; shift 2 ;;
            --desc) _by=desc; _query="$2"; shift 2 ;;
            --match) _match="$2"; shift 2 ;;
            *) die "text: unknown option $1" ;;
        esac
    done
    set -- SET_TEXT text "$_value"
    if [ -n "$_query" ]; then
        set -- "$@" by "$_by" query "$_query"
        [ -n "$_match" ] && set -- "$@" match "$_match"
    fi
    # no target -> the server types into the currently focused field.
    send "$@"
}

cmd_global() { need_token; send GLOBAL nav "$1"; }

# scroll the screen in a direction; with a query, keep scrolling (server-side)
# until a node matches, else perform a single scroll (or --steps N of them).
cmd_scroll() {
    need_token
    _dir="${1:-}"
    case "$_dir" in
        up|down|left|right) shift ;;
        *) die "usage: mimic scroll up|down|left|right [QUERY] [--by text|id|class|desc] [--match M] [--timeout S] [--steps N] [--package P] [--filter F]" ;;
    esac
    _query=; _by=; _match=; _timeout=; _steps=; _pkg=; _filter=; _skip=
    while [ $# -gt 0 ]; do
        case "$1" in
            --by) _by="$2"; shift 2 ;;
            --match) _match="$2"; shift 2 ;;
            --timeout) _timeout="$2"; shift 2 ;;
            --steps) _steps="$2"; shift 2 ;;
            --package) _pkg="$2"; shift 2 ;;
            --filter) _filter="$2"; shift 2 ;;
            --skip-visible) _skip=1; shift ;;
            -*) die "scroll: unknown option $1" ;;
            *) _query="$1"; shift ;;
        esac
    done
    set -- SCROLL direction "$_dir"
    [ -n "$_query" ]   && set -- "$@" query "$_query"
    [ -n "$_by" ]      && set -- "$@" by "$_by"
    [ -n "$_match" ]   && set -- "$@" match "$_match"
    [ -n "$_timeout" ] && set -- "$@" timeout "$_timeout"
    [ -n "$_steps" ]   && set -- "$@" steps "$_steps"
    [ -n "$_pkg" ]     && set -- "$@" package "$_pkg"
    [ -n "$_filter" ]  && set -- "$@" filter "$_filter"
    [ -n "$_skip" ]    && set -- "$@" skip_visible true
    send "$@"
}

# wait until a node matches the query (polls the active window server-side).
cmd_wait() {
    need_token
    _query="${1:-}"; [ -n "$_query" ] || die "usage: mimic wait QUERY [--by text|id|class|desc] [--match exact|contains|regex] [--timeout SECONDS] [--package P] [--filter F]"
    shift
    _by=; _match=; _timeout=; _pkg=; _filter=
    while [ $# -gt 0 ]; do
        case "$1" in
            --by) _by="$2"; shift 2 ;;
            --match) _match="$2"; shift 2 ;;
            --timeout) _timeout="$2"; shift 2 ;;
            --package) _pkg="$2"; shift 2 ;;
            --filter) _filter="$2"; shift 2 ;;
            *) die "wait: unknown option $1" ;;
        esac
    done
    set -- WAIT query "$_query"
    [ -n "$_by" ]      && set -- "$@" by "$_by"
    [ -n "$_match" ]   && set -- "$@" match "$_match"
    [ -n "$_timeout" ] && set -- "$@" timeout "$_timeout"
    [ -n "$_pkg" ]     && set -- "$@" package "$_pkg"
    [ -n "$_filter" ]  && set -- "$@" filter "$_filter"
    send "$@"
}

cmd_packages() {
    need_token
    # capture args before rebuilding the positional params for send.
    _q=; _fuzzy=
    while [ $# -gt 0 ]; do
        case "$1" in
            --fuzzy) _fuzzy=1; shift ;;
            -*) die "packages: unknown option $1" ;;
            *) _q="$1"; shift ;;
        esac
    done
    set -- PACKAGES
    [ -n "$_q" ] && set -- "$@" query "$_q"
    [ -n "$_fuzzy" ] && set -- "$@" fuzzy true
    send "$@"
}

cmd_launch() {
    need_token
    _pkg=; _component=; _action=; _uri=; _wait=; _timeout=
    case "${1:-}" in
        "") die "usage: mimic launch PACKAGE | --component PKG/.ACT | --action ACTION [--uri URI] [--package PKG] | --uri URI [--wait] [--timeout SECONDS]" ;;
        --*) ;;
        *) _pkg="$1"; shift ;;
    esac
    while [ $# -gt 0 ]; do
        case "$1" in
            --component) _component="$2"; shift 2 ;;
            --action) _action="$2"; shift 2 ;;
            --uri) _uri="$2"; shift 2 ;;
            --package) _pkg="$2"; shift 2 ;;
            --wait) _wait=1; shift ;;
            --timeout) _timeout="$2"; shift 2 ;;
            *) die "launch: unknown option $1" ;;
        esac
    done
    set -- LAUNCH
    [ -n "$_pkg" ]       && set -- "$@" package "$_pkg"
    [ -n "$_component" ] && set -- "$@" component "$_component"
    [ -n "$_action" ]    && set -- "$@" action "$_action"
    [ -n "$_uri" ]       && set -- "$@" uri "$_uri"
    [ -n "$_wait" ]      && set -- "$@" wait true
    [ -n "$_timeout" ]   && set -- "$@" timeout "$_timeout"
    send "$@"
}

# capture the screen to a file (a unique /tmp file by default) and print the path.
# binary output, so it bypasses the json envelope path.
cmd_screenshot() {
    need_token
    _dest=; _format=png; _quality=; _scale=
    while [ $# -gt 0 ]; do
        case "$1" in
            --format) _format="$2"; shift 2 ;;
            --quality) _quality="$2"; shift 2 ;;
            --scale) _scale="$2"; shift 2 ;;
            -*) die "screenshot: unknown option $1" ;;
            *) _dest="$1"; shift ;;
        esac
    done
    if [ -z "$_dest" ]; then
        _base=$(mktemp "${TMPDIR:-/tmp}/mimic-screenshot-XXXXXX") || die "could not create temp file"
        _dest="$_base.$_format"; mv "$_base" "$_dest"
    fi
    if [ "$TRANSPORT" = http ]; then
        _body="{\"format\":\"$_format\""
        [ -n "$_quality" ] && _body="$_body,\"quality\":\"$_quality\""
        [ -n "$_scale" ] && _body="$_body,\"scale\":\"$_scale\""
        _body="$_body}"
        curl -sS -H "x-mimic-token: $TOKEN" -H 'content-type: application/json' \
            -X POST "http://$HOST/v1/screenshot" -d "$_body" -o "$_dest" 2>/dev/null
        # an error comes back as a json envelope, not image bytes
        if head -c1 "$_dest" 2>/dev/null | grep -q '{'; then
            _err=$(sed -n 's/.*"error":"\([^"]*\)".*/\1/p' "$_dest"); rm -f "$_dest"
            die "screenshot failed: ${_err:-unknown}"
        fi
    else
        set -- broadcast -n "$COMPONENT" -a "${ACT_PREFIX}SCREENSHOT" --es token "$TOKEN" --es format "$_format"
        [ -n "$_quality" ] && set -- "$@" --es quality "$_quality"
        [ -n "$_scale" ] && set -- "$@" --es scale "$_scale"
        _dec=$(decode_output "$(run_am_argv "$@" 2>/dev/null || true)") || { rm -f "$_dest"; return 1; }
        case "$_dec" in
            *'"ok":true'*) printf '%s' "$_dec" | sed -n 's/.*"data":"\([^"]*\)".*/\1/p' | base64 -d > "$_dest" 2>/dev/null ;;
            *) _err=$(printf '%s' "$_dec" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p'); rm -f "$_dest"; die "screenshot failed: ${_err:-unknown}" ;;
        esac
    fi
    [ -s "$_dest" ] || { rm -f "$_dest"; die "screenshot produced no data (rate-limited? try again)"; }
    printf '%s\n' "$_dest"
}

usage() {
    cat <<EOF
mimic -- drive the mimic service from a shell.
transport: $TRANSPORT (http host $HOST; intents via $AM)

setup (start pairing in the app first to get a code):
  mimic pair [CODE] [LABEL]   exchange a one-time code for a per-client token
  mimic set-token [TOKEN]     save a legacy token revealed in the app (manual path)
  mimic update [DEST]         re-download this script from the host server
  mimic status                service enabled? which surfaces are on?

view (filter/query run on-device to keep output small):
  mimic dump [--filter interactive|text|visible|all] [--format tree|flat|compact]
            [--max-depth N] [--package PKG] [--fields class,text,desc,label,id,bounds,center,actions]
                  (--filter takes a comma list and requires all of them:
                   --filter interactive,visible surveys what is on screen and actionable.
                   --fields picks the compact columns, in the order given)
  mimic find QUERY [--by text|id|class|desc] [--match exact|contains|regex] [+ dump opts]

interact:
  mimic tap X Y [--duration MS]        mimic longpress X Y [--duration MS]
  mimic swipe X1 Y1 X2 Y2 [--duration MS]
  mimic click X Y | --id ID | --text T | --class C | --desc D [--match M]
  mimic text VALUE [--id ID | --text T | --class C | --desc D] [--match M]
                  (no target -> types into the currently focused field)
  mimic back | home | recents | notifications
  mimic scroll up|down|left|right [QUERY] [--match M] [--timeout S] [--steps N] [--skip-visible]
                  (with QUERY: scroll until it is on screen; without: one scroll, or --steps N.
                   --skip-visible ignores matches already shown and finds the next one)
  mimic wait QUERY [--by text|id|class|desc] [--match M] [--timeout S] [--package P]
                  (poll until a node matches; default timeout 10s, http for long waits)
  mimic packages [QUERY] [--fuzzy]     list launchable apps (package, label, component)
  mimic launch PACKAGE | --component PKG/.ACT | --action ACTION [--uri URI] | --uri URI
                  [--wait] [--timeout S]   (--wait blocks until the app is foreground)
  mimic screenshot [PATH] [--format png|jpeg] [--quality 1-100] [--scale 0-1]
                  (last resort; prefer the text tree. writes a /tmp file, prints the path)

output is the raw json envelope on stdout; nonzero exit on error.
prefix any command with --pretty for human-friendly output (requires jq):
  mimic --pretty dump --filter interactive,visible --format compact
EOF
}

# global flags (before the subcommand): --pretty (jq, human-friendly), --raw (default).
PRETTY="${MIMIC_PRETTY:-0}"
while [ $# -gt 0 ]; do
    case "$1" in
        --pretty) PRETTY=1; shift ;;
        --raw) PRETTY=0; shift ;;
        --) shift; break ;;
        *) break ;;
    esac
done

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
    status) cmd_status "$@" ;;
    pair) cmd_pair "$@" ;;
    set-token) cmd_set_token "$@" ;;
    update) cmd_update "$@" ;;
    dump|view) cmd_view "$@" ;;
    find) cmd_find "$@" ;;
    tap) cmd_tap "$@" ;;
    longpress|long) cmd_long "$@" ;;
    swipe) cmd_swipe "$@" ;;
    click) cmd_click "$@" ;;
